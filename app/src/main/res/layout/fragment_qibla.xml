<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/qibla_direction"
        android:textColor="@color/olive_dark"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="24dp"
        android:text="@string/qibla_calibrate"
        android:textColor="@color/text_gray"
        android:textSize="13sp" />

    <FrameLayout
        android:layout_width="280dp"
        android:layout_height="280dp">

        <ImageView
            android:id="@+id/img_compass_dial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_compass_circle"
            android:padding="20dp"
            android:src="@drawable/ic_qibla" />

        <ImageView
            android:id="@+id/img_qibla_needle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_compass_pointer" />

        <FrameLayout
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_kaaba_circle">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_kaaba" />
        </FrameLayout>

    </FrameLayout>

    <TextView
        android:id="@+id/text_qibla_angle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="0°"
        android:textColor="@color/gold"
        android:textSize="26sp"
        android:textStyle="bold" />

</LinearLayout>
