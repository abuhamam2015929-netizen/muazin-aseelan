<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"
            android:text="@string/nav_settings"
            android:textColor="@color/olive_dark"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- المؤذن العام -->
        <LinearLayout
            android:id="@+id/row_global_muadhin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_settings_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/choose_muadhin"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_global_muadhin_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/text_gray"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- التاريخ الهجري -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_settings_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/hijri_offset_title"
                android:textColor="@color/text_dark"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/btn_hijri_minus"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_kaaba_circle"
                android:padding="6dp"
                android:src="@drawable/ic_off" />

            <TextView
                android:id="@+id/text_hijri_offset"
                android:layout_width="34dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/text_dark"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btn_hijri_plus"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_kaaba_circle"
                android:padding="6dp"
                android:src="@drawable/ic_sound_full" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/settings_per_prayer"
            android:textColor="@color/olive_dark"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/prayer_settings_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
